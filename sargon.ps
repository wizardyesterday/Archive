        DCR     B       ; Decrement list count)WR(
        INX     H       ; Increment list        inter
        CMP     M       ; Check next item in list
        JRZ     .-2     ; Jump if empty
        RRD             ; Get value from list
        ADD     A       ; Double it
        DCX     H       ; Decrement list pointer
NX6:    EXX ; Restore regs.
        RET ; Return


