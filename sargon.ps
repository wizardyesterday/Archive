;       LDA     KOLOR
;       ANA     A
;       RNZ
;       PRTBLK  SPACE,6
;       RET
; 
; **************************************************************
TAB TO COMPUTERS COLUMN W/O MOVE NO.
; **************************************************************
; FUNCTION:     --      Like TBCPCL, except that the move number
;               is not reprinted.
; 
;CALLED BY: -- CPTRMV
; **************************************************************
TBCPMV: PRTBLK  SPACE,3
        LDA     KOLOR
