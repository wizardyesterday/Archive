        .BYTE   OBE,0BF,0BF,95
        .BYTE   OA0,0BE,0BF,85
        .BYTE   83,83,83,81
        .BYTE   80,0A0,00,80    ; Black Bishop on White square
        .BYTE   OA8,0BF,0BD,80
        .BYTE   82,0AF,87,80
        .BYTE   82,83,83,80
        .BYTE   80,80,80,80     ; Black Rook on White square
        .BYTE   8A,0BE,0BD,85
        .BYTE   80,0BF,0BF,80
        .BYTE   82,83,83,81
        .BYTE   90,80,80,90     ; Black Queen on White square
        .BYTE   OBF,0B4,0BE,95
        .BYTE   8B,0BF,9F,81
        .BYTE   83,83,83,81
        .BYTE   80,088,90,80    ; Black King on White square
        .BYTE   OBC,0BA,0B8,94
        .BYTE   OAF,0BF,0BF,85
        .BYTE   83,83,83,81
        .BYTE   90,0B0,0B0,80   ; Toppled Black King
        .BYTE   OBF,0BF,0B7,80
        .BYTE   9F,0BF,0BD,80
        .BYTE   80,80,88,9D
KERNEL =        .-BLBASE
        .BYTE   OBF,9F,0AF,0BF,9A,0A5   ; Pawn Kernel
        .BYTE   89,0AF,0BF,9F,0B9,9F    ; Knight Kernel)WR(
        .BYTE   97,0BE,96,0BD,9B,0B9    ; Bishop Kernel
        .BYTE   0B5,0A1,92,0BF,0AA,95   ; Rook Kernel
